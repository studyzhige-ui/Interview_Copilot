# Environments
.env
.env.*
!.env.example
!.env.example.lite
!.env.docker.example

# User-local prompt scratchpad (not project content)
docs/prompts/

# Local RAG quality harness — the OLD top-level evaluation/ files use a
# hand-curated 835-row golden dataset scraped from copyrighted PDFs; kept off
# GitHub for that reason. The NEW evaluation/rag/ subsystem (Phase D) is
# version-controlled CODE, but its gold datasets embed fixture content (same
# copyright caution) so evaluation/rag/datasets/ stays local; run-output reports
# live under data/evaluation/ (ignored via data/).
evaluation/*
!evaluation/rag/
evaluation/rag/datasets/
.venv/
env/
venv/
ENV/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# Runtime data
data/
backend/data/
*.db
*.sqlite3
*.sqlite3-journal

# dev.ps1 captured logs
logs/

# ML model artifacts (large binary files)
*.safetensors
*.bin
*.npz
*.incomplete

# Tool caches
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# IDEs and OS
.idea/
