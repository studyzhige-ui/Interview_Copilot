# Local-first OVERLAY. Merge selected values into your existing .env; do NOT
# replace database credentials, SECRET_KEY, paths or existing provider keys.
# Finite local TTS is available through the configured broker; model/device
# acceptance and real-time streaming/WebRTC remain separate. Missing local
# components fail explicitly, without an Edge or other cloud fallback.
APP_EDITION=community
AUXILIARY_MODEL_POLICY=local_only
LOCAL_MODELS_OFFLINE=true

# Leave empty to reuse CACHE_DIR/models. In WSL an existing Windows D: directory
# is /mnt/d/...; do not pass a Windows drive string to the Linux process.
# Weights may be read-only. HF/Torch metadata uses writable CACHE_DIR separately.
MODEL_ROOT_DIR=
MODEL_REVISIONS_JSON={}

# Reuse the downloaded baseline before changing models and index generation.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
TRANSCRIPTION_PROVIDER=local_whisperx
TRANSCRIPTION_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
TRANSCRIPTION_ALIGNMENT_MODEL=jonatasgrosman/wav2vec2-large-xlsr-53-chinese-zh-cn
DIARIZATION_MODE=auto
DIARIZATION_MODEL_ID=pyannote-community/speaker-diarization-community-1
PARSER_PROVIDER=docling
RAG_OCR_ENABLED=true

# DeepSeek remains online. Do not set its key here or commit a real key.
# Preserve your already-configured INTERNAL_LLM_PROVIDER/MODEL and credentials.
# Optional EVAL_JUDGE_API_KEY/API_BASE/MODEL is a complete triple; without it the
# existing DeepSeek judge configuration is used. No other paid-provider key needed.

# Local RAG weights are owned by one independently launched model broker.
# Use the socket printed by scripts/prepare_local_inference.py; no implicit spawn.
# Default when blank: APP_DATA_DIR/inference/run/worker.sock (Linux/WSL2).
LOCAL_INFERENCE_SOCKET=
LOCAL_INFERENCE_TIMEOUT_SECONDS=120
# Explicit model input semantics. Changing these creates a new vector generation.
LOCAL_EMBED_MAX_TOKENS=8192
LOCAL_EMBED_QUERY_PREFIX=
LOCAL_EMBED_TEXT_PREFIX=

# Explicit local preset-voice synthesis; requires prepared --tts-python role.
TTS_PROVIDER=local_qwen3_tts
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
TTS_DEFAULT_VOICE=Vivian
TTS_LANGUAGE=Auto
